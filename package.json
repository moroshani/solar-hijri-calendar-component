{
  "name": "solar-hijri-calendar-component",
  "version": "0.1.0",
  "description": "Reusable React Solar Hijri / Jalali calendar component.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Mohammad Mehdi Roshani",
    "email": "moroshaniofficial@gmail.com",
    "url": "https://github.com/moroshani"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/moroshani/solar-hijri-calendar-component.git"
  },
  "bugs": {
    "url": "https://github.com/moroshani/solar-hijri-calendar-component/issues"
  },
  "homepage": "https://github.com/moroshani/solar-hijri-calendar-component#readme",
  "keywords": [
    "react",
    "calendar",
    "jalali",
    "solar-hijri",
    "persian",
    "rtl",
    "datepicker"
  ],
  "sideEffects": [
    "dist/styles.css",
    "src/styles.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "dev": "vite --config playground/react/vite.config.ts --host 127.0.0.1",
    "dev:react": "vite --config playground/react/vite.config.ts --host 127.0.0.1",
    "build:playground": "vite build --config playground/react/vite.config.ts",
    "preview:react": "vite preview --config playground/react/vite.config.ts --host 127.0.0.1",
    "lint": "tsc --noEmit && tsc -p playground/react/tsconfig.json --noEmit",
    "screenshots": "playwright test --config tests/playwright/playwright.config.mjs --grep @visual",
    "test:e2e": "playwright test --config tests/playwright/playwright.config.mjs --grep-invert @visual",
    "test": "vitest run",
    "verify": "npm run lint && npm test && npm run build && npm run build:playground && npm run test:e2e && npm run screenshots",
    "package:check": "npm pack --dry-run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "jalaali-js": "^1.2.8"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@fontsource/vazirmatn": "^5.3.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.0.0",
    "lucide-react": "^1.30.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "nanoid": "3.3.17",
    "postcss": "8.5.26"
  }
}
